{
  "name": "agility",
  "productName": "Agility",
  "version": "0.1.0",
  "description": "Agility \u2014 a cross-platform desktop PDF editor: edit text, OCR scans, annotate, sign, fill forms and rearrange pages.",
  "main": "main.js",
  "license": "MIT",
  "author": "Agility",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "test": "playwright test",
    "dist:msix": "electron-builder --win appx --x64 --arm64"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/sacramento": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@signpdf/placeholder-pdf-lib": "^4.0.0",
    "@signpdf/signer-p12": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.agility.pdf",
    "productName": "Agility",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "tabs-preload.js",
      "updater.js",
      "src/**/*",
      "package.json",
      "office.js",
      "sign.js",
      "!node_modules/@napi-rs/**"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "signtoolOptions": {
        "publisherName": "Agility"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Agility"
    },
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "YOUR-GITHUB-USER",
        "repo": "agility",
        "releaseType": "release"
      }
    ],
    "appx": {
      "identityName": "Agility.PDFEditor",
      "applicationId": "Agility",
      "displayName": "Agility",
      "publisher": "CN=Agility Development",
      "publisherDisplayName": "Agility",
      "backgroundColor": "transparent",
      "showNameOnTiles": true,
      "languages": [
        "en-US"
      ],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "artifactName": "${productName}-${version}-${arch}.msix"
    }
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
